# ---------------------------------------------------------------------------
# Torshi Tala marketing site — build-time environment variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local (gitignored) and adjust as needed for local dev.
#
#   cp .env.example .env.local
#
# This site is a STATIC EXPORT (next.config.mjs: output: 'export'). The backend
# API is consumed at BUILD TIME only (inside Server Components / generateMetadata
# during `next build`). There is NO client-side or runtime fetching, so this var
# is SERVER-ONLY and must NOT be prefixed with NEXT_PUBLIC_.

# Base URL of the Torshi Tala backend API (no trailing slash).
# Defaults to https://localhost:7153/api/v1 when unset (see lib/api.ts).
API_BASE_URL=https://localhost:7153/api/v1

# ---------------------------------------------------------------------------
# Local SSG builds against the backend
# ---------------------------------------------------------------------------
# To pull live content at build time, the backend API must be RUNNING and its
# HTTPS dev certificate must be TRUSTED, otherwise the build-time fetch fails on
# the TLS handshake (Node does not use the OS trust store the way browsers do).
#
#   dotnet dev-certs https --trust        # trust the ASP.NET Core dev cert
#
# For a quick LOCAL-ONLY build you may instead disable TLS verification for the
# build process (never do this in CI/production):
#
#   NODE_TLS_REJECT_UNAUTHORIZED=0 npm run build      # bash
#   $env:NODE_TLS_REJECT_UNAUTHORIZED=0; npm run build  # PowerShell
#
# If the API is simply unreachable, the build STILL SUCCEEDS: every fetcher in
# lib/api.ts falls back to the hardcoded config/*.ts data.
